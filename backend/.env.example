DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_issue_intelligence
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GitHub OAuth. GITHUB_CLIENT_* is preferred; GITHUB_OAUTH_CLIENT_* is also supported.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback
FRONTEND_GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

GITHUB_TOKEN=
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# Email delivery with Resend. Configure these to enable verification and password reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GitSense <no-reply@gitsense.app>
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/login
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# AI narration layer (optional). When unset, GitSense falls back to a
# deterministic summarizer so the dashboard always renders a briefing.
#
# Preferred: OpenRouter (free DeepSeek model).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# Optional attribution headers OpenRouter recommends.
OPENROUTER_REFERER=https://gitsense.app
OPENROUTER_APP_TITLE=GitSense

# Backwards-compatible generic provider config (used only when
# OPENROUTER_API_KEY is empty). Any OpenAI-compatible chat-completions
# endpoint works (OpenAI, Together, Groq, local Ollama with the OpenAI
# shim, llama.cpp server, etc.).
AI_NARRATION_API_KEY=
AI_NARRATION_BASE_URL=https://api.openai.com/v1
AI_NARRATION_MODEL=gpt-4o-mini
