# ============================================================
# GitSense backend — environment template
# ============================================================
# Two example value styles are shown for every host-bound value:
#   - local development (commented "dev")
#   - production on api.gitsense.tech (commented "prod")
# Pick the one that matches your deployment.

# --- Core ---------------------------------------------------

# Neon (production) or local Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/github_issue_intelligence
# prod: postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins. Local default
# is localhost:3000; production should be the public frontend
# origin(s).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# prod: https://gitsense.tech,https://www.gitsense.tech


# --- GitHub OAuth ------------------------------------------
# GITHUB_CLIENT_* is preferred; GITHUB_OAUTH_CLIENT_* is also
# supported for backwards compatibility.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Callback URL **on the backend** (must match GitHub OAuth app
# settings exactly).
GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback
# prod: https://api.gitsense.tech/auth/oauth/github/callback

# Where the backend redirects the browser after OAuth completes.
# Must point at the frontend.
FRONTEND_GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
# prod: https://gitsense.tech/auth/github/callback

# Optional: classic personal access token used for unauthenticated
# GitHub API calls to raise the rate limit ceiling.
GITHUB_TOKEN=


# --- Google OAuth (optional) -------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
# prod: https://api.gitsense.tech/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback


# --- Email (Resend) ----------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=GitSense <no-reply@gitsense.tech>
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/login
# prod: https://gitsense.tech/login
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
# prod: https://gitsense.tech/reset-password


# --- AI narration (optional) -------------------------------
# When unset, GitSense falls back to a deterministic summarizer
# so the dashboard always renders a briefing.
#
# Preferred: OpenRouter (free DeepSeek model).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Optional attribution headers OpenRouter recommends.
OPENROUTER_REFERER=https://gitsense.tech
OPENROUTER_APP_TITLE=GitSense

# Backwards-compatible generic provider config (used only when
# OPENROUTER_API_KEY is empty). Any OpenAI-compatible chat-
# completions endpoint works.
AI_NARRATION_API_KEY=
AI_NARRATION_BASE_URL=https://api.openai.com/v1
AI_NARRATION_MODEL=gpt-4o-mini
