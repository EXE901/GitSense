# ============================================================
# GitSense — root .gitignore
# ============================================================

# -- Dependencies --------------------------------------------
node_modules/
backend/venv/
backend/.venv/

# -- Build artifacts -----------------------------------------
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
**/__pycache__/
*.pyc

# -- Environment files ---------------------------------------
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env.local
frontend/.env.*.local
.env
.env.local

# -- Local databases -----------------------------------------
*.sqlite
*.sqlite3
*.db

# -- Logs ----------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.dev-log*.txt

# -- Test / scratch artifacts --------------------------------
cookies.txt
ai-briefing-live.json
*.har
report.txt
*-report.txt
audit-*.md
migration-*.md
implementation-*.md

# -- Generated / MCP / Playwright screenshots ----------------
# Curated repository screenshots (used by README) live in
# docs/screenshots/ and ARE committed. Any other PNG at root
# or in tour/test directories is treated as a scratch artifact.
.playwright-mcp/
playwright-report/
test-results/
/tour-*.png
/audit-*.png
/qa-*.png
/test-*.png
/screenshot-*.png
/final-*.png
/dashboard-*.png
/*-screenshot.png

# Keep curated screenshots used by the README.
!docs/screenshots/
!docs/screenshots/**

# -- Quarantined / archived ----------------------------------
.cleanup_review/
.archive/

# -- Editor / OS ---------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# -- AI / agent rules (internal, not for public repo) --------
AGENTS.md
CLAUDE.md
**/AGENTS.md
**/CLAUDE.md

# -- Python tooling caches -----------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -- Coverage artifacts --------------------------------------
coverage/
.coverage
htmlcov/

# -- AI / editor tooling -------------------------------------
.cursor/
.windsurf/
.roo/

# -- Vercel --------------------------------------------------
.vercel/

# -- Optional future tooling ---------------------------------
.turbo/
.pnpm-store/
